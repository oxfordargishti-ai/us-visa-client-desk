# ─────────────────────────────────────────────────────────────────────────────
#  US VISA WITH ARGISHTI — AI Client Desk · environment variables
#  Copy to .env.local for development. On Vercel, add each one under
#  Project → Settings → Environment Variables. NEVER commit real values.
#  Lines marked REQUIRED must be set in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# REQUIRED. Public https URL of the deployed app, no trailing slash.
APP_URL=https://desk.usvisawithargishti.com

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# REQUIRED in production (Neon, Supabase, Vercel Postgres, RDS ...).
# Leave empty in development to use the built-in local Postgres (PGlite) stored in .data/
DATABASE_URL=

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED. Generate all four at once with:  npm run vapid
ENCRYPTION_KEY=            # 32 random bytes, base64 — encrypts Google tokens and push keys
CRON_SECRET=               # protects /api/cron/dispatch

# ── First owner account (used once by `npm run db:migrate`) ──────────────────
OWNER_EMAIL=info@usvisawithargishti.com
OWNER_NAME=Argishti
OWNER_INITIAL_PASSWORD=    # at least 10 characters, letters + numbers. Remove after first sign-in.

# ── Push notifications (Web Push / VAPID) ────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@usvisawithargishti.com

# ── Claude AI (task generator, day suggestions, email summaries) ─────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Google (Gmail read-only + optional Calendar sync + optional Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ACCOUNT=info@usvisawithargishti.com
GOOGLE_LOGIN_ENABLED=false # true = show "Sign in with Google" (existing users only)

# ── Email fallback for reminders (any SMTP provider: Resend, Postmark, Gmail SMTP ...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM="US VISA WITH ARGISHTI <info@usvisawithargishti.com>"

# ── Private document storage ─────────────────────────────────────────────────
# local = a folder on the server (development only; not durable on Vercel)
# s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2) — REQUIRED in production
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=               # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hosted without a terminal (e.g. Vercel): apply migrations and create the owner login at server start.
# AUTO_MIGRATE=true
