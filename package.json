{
  "name": "us-visa-ai-client-desk",
  "version": "1.0.0",
  "private": true,
  "description": "US VISA WITH ARGISHTI \u2014 AI Client Desk: tasks, interviews, clients, documents, Gmail and server-side reminders",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "vapid": "tsx scripts/generate-vapid.ts",
    "icons": "node scripts/make-icons.mjs",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:?set TEST_DATABASE_URL to a throwaway PostgreSQL database} vitest run",
    "test:e2e": "tests/e2e/run.sh dev",
    "backup": "scripts/backup.sh",
    "migrations:embed": "node scripts/embed-migrations.mjs",
    "prebuild": "node scripts/embed-migrations.mjs",
    "pretest": "node scripts/embed-migrations.mjs"
  },
  "dependencies": {
